# =============================================================================
# Musawo AI — Environment Configuration
# Copy to .env and fill in your values:  cp .env.example .env
#
# This file is the SINGLE SOURCE OF TRUTH for backend configuration and mirrors
# backend/app/config.py (Settings). Lines tagged `# secret` must NEVER hold a
# real value here — set those only in your local .env (gitignored) or the
# deployment secrets manager. Lines tagged `# optional` are safe to leave blank.
# =============================================================================

# ── Application / server ─────────────────────────────────────────────────────
APP_ENV=development            # development | staging | production (production = strict CORS)
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3200,http://localhost:8000,http://localhost:8888,http://127.0.0.1:3200,http://127.0.0.1:8888
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60           # seconds
SMS_API_KEY=                   # secret, optional — gates POST /v1/sms/send
MAX_AUDIO_SIZE=10485760        # 10 MB, max audio upload bytes

# ── LLM backend (fallback: gemini → groq → gguf → bnb4 → transformers → passages) ──
LLM_BACKEND=gemini             # gemini | groq | local | passages

# Gemini (default). OpenAI-compatible endpoint. Get a key at https://aistudio.google.com
GEMINI_API_KEY=                # secret
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.3

# Groq (fallback — free tier). Get a key at https://console.groq.com
GROQ_API_KEY=                  # secret
GROQ_MODEL=llama-3.3-70b-versatile   # or qwen/qwen3-32b
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.3

# OpenAI — Whisper STT for English voice (preferred when set; else local Whisper)
OPENAI_API_KEY=                # secret, optional

# Local model fallback (offline / GPU). Env names are LLM_*
LLM_MODEL=Qwen/Qwen3-8B
LLM_CONTEXT_WINDOW=8192
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2
LLM_DEVICE=auto                # auto | cpu | cuda
GGUF_MODEL_PATH=               # optional — set to enable the GGUF/llama-cpp tier
LOCAL_GPU_LAYERS=0             # GGUF layers to offload to GPU
LORA_ADAPTER_PATH=             # optional — fine-tuned adapter merged at load time

# ── Retrieval / indexing (Qdrant + bge-m3) ──────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=musawo_health_kb
DENSE_MODEL=BAAI/bge-m3
DENSE_DIM=1024
RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v2
RERANK_ENABLED=true
BM25_STATE_PATH=knowledge-base/bm25_state.json
PREFETCH_LIMIT=20
KNOWLEDGE_BASE_DIR=knowledge-base    # canonical KB dir (replaces the old KB_DIR)
CHUNK_SIZE=600                 # indexer: chunk size (chars)
CHUNK_OVERLAP=100              # indexer: chunk overlap (chars)
INDEX_BATCH_SIZE=64            # indexer: embedding batch size

# ── Semantic cache ───────────────────────────────────────────────────────────
CACHE_BACKEND=memory           # memory | redis
CACHE_ENABLED=true
CACHE_THRESHOLD=0.92           # cosine similarity for a cache hit
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000            # max entries (memory backend)
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_PREFIX=musawo:cache:

# ── Corrective RAG ───────────────────────────────────────────────────────────
CORRECTIVE_RAG_ENABLED=true
CORRECTIVE_RAG_THRESHOLD=0.3   # min avg reranker score before re-retrieval

# ── Guardrails & clinical safety ─────────────────────────────────────────────
MAX_INPUT_LENGTH=2000
ABSTENTION_THRESHOLD=0.05      # confidence below which the system abstains
ESCALATION_THRESHOLD=0.25
GROUNDING_THRESHOLD=0.3
CLINICAL_SAFETY_THRESHOLD=0.2  # faithfulness gate; below this the answer is gated/warned
LLM_INFERENCE_TIMEOUT=45       # seconds
SESSION_TTL_SECONDS=86400      # 24 hours
LLM_WORKERS=2                  # service thread-pool size for blocking LLM calls
AUDIT_LOG_PATH=/tmp/musawo_audit.jsonl

# ── Sunbird AI — Ugandan-language voice & translation ───────────────────────
SUNBIRD_API_URL=https://api.sunbird.ai
SUNBIRD_TIMEOUT=30
# Prefer USERNAME/PASSWORD (auto-refreshing token) over the static API token.
SUNBIRD_USERNAME=              # secret, optional
SUNBIRD_PASSWORD=              # secret, optional
SUNBIRD_API_TOKEN=             # secret, optional — static fallback
SUNBIRD_FALLBACK_USERNAME=     # secret, optional
SUNBIRD_FALLBACK_PASSWORD=     # secret, optional
SUNBIRD_FALLBACK_API_TOKEN=    # secret, optional — static token for a 2nd Sunbird account
COSYVOICE_MODEL=iic/CosyVoice2-0.5B

# ── Twilio SMS / USSD ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=            # secret, optional
TWILIO_AUTH_TOKEN=             # secret, optional
TWILIO_PHONE_NUMBER=           # e.g. +1234567890

# ── Voice activity detection (streaming voice) ──────────────────────────────
VOICE_SILERO_ENABLED=true
VOICE_VAD_ENERGY_THRESHOLD=0.015
VOICE_VAD_SILENCE_MS=600
VOICE_VAD_MIN_SPEECH_MS=250
VOICE_VAD_MAX_UTTERANCE_S=30.0

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://musawo.ai          # client-exposed canonical URL (metadata)
NEXT_PUBLIC_API_URL=http://localhost:8000       # client-exposed API base (dev)
INTERNAL_API_URL=http://api:8000                # SERVER-ONLY proxy target — do NOT prefix NEXT_PUBLIC_

# ── Deployment only (consumed by docker-compose.yml, NOT by app code) ───────
API_PORT=8000
FRONTEND_PORT=3000
REDIS_PORT=6379
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
GRAFANA_PASSWORD=musawo        # secret — monitoring profile only
HF_TOKEN=                      # secret, optional — HuggingFace gated-model downloads
